# Environment Aplikasi Web KOPERASI DIGITAL PRO
NODE_ENV="production"
PORT="3000"

# Ganti dengan string acak yang kuat saat deploy di DewaHoster
SESSION_SECRET="GANTI_DENGAN_KUNCI_RAHASIA_MINIMAL_32_KARAKTER"

# APP_URL: Domain publik aplikasi Anda di DewaHoster
APP_URL="https://domainkoperasianda.com"

# Opsional: Hanya diperlukan jika menggunakan fitur Gemini AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"
